#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/charlielidbury/Documents/repos/icl-sail" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/charlielidbury/Documents/repos/icl-sail")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/charlielidbury/Documents/repos/icl-sail" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/Users/charlielidbury/Documents/repos/icl-sail/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/Users/charlielidbury/Documents/repos/icl-sail/.envrc" "/Users/charlielidbury/Documents/repos/icl-sail/.direnv"/*.rc
